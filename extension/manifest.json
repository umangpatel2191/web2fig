{
  "manifest_version": 3,
  "name": "Web2Fig — Website to Figma",
  "version": "0.3.0",
  "description": "Capture any website as editable Figma layers: real frames, text, images and Auto Layout. Paste into Figma with the free plugin.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Web2Fig — capture this page",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "offscreen",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "capture-page": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Web2Fig: capture the current page (uses your last settings)"
    }
  }
}
